  <script>
    // Intro handoff — the badge arrives full-viewport, then the overlay
    // fades while the (now larger) hero badge pops in at the same moment.
    // Both are the same transparent PNG on the same cream ground, so it
    // reads as one object settling into place. Once per session
    // (sessionStorage), skippable, and fully reduced-motion safe: with
    // reduced motion the overlay never shows and the hero badge is simply
    // visible from the start — the hero itself is real, readable content
    // underneath the whole time, never gated behind the intro.
    const SEEN_KEY = '4everfit-intro-seen';
    // Timings are set in CSS (--intro-arrive-dur / --intro-sheen-delay /
    // --intro-sheen-dur); the handoff follows the sheen's animationend, so
    // this is only the failsafe for browsers that never fire it.
    const HANDOFF_AFTER_MS = 3600;
    const overlay = document.getElementById('intro-overlay');
    const badge = document.getElementById('intro-badge');
    const skipBtn = document.getElementById('intro-skip');
    const heroBadges = document.querySelectorAll<HTMLElement>('[data-hero-badge]');
    const prefersReducedIntro = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const alreadySeen = (() => {
      try {
        return sessionStorage.getItem(SEEN_KEY) === '1';
      } catch {
        return false;
      }
    })();

    function landHero() {
      heroBadges.forEach((el) => el.classList.add('is-landed'));
    }

    function finishIntro() {
      if (overlay) {
        overlay.classList.add('intro-done');
        document.body.style.overflow = '';
        window.setTimeout(() => overlay.remove(), 700);
      }
      landHero();
      try {
        sessionStorage.setItem(SEEN_KEY, '1');
      } catch {
        /* private browsing — fine to skip persisting */
      }
    }

    if (!overlay || !badge || prefersReducedIntro || alreadySeen) {
      overlay?.remove();
      landHero();
    } else {
      document.body.style.overflow = 'hidden';
      let handedOff = false;
      const handOff = () => {
        if (handedOff) return;
        handedOff = true;
        finishIntro();
      };
      // Drive off the sheen actually finishing rather than a bare timer, so
      // the handoff stays in step if the timing is retuned in CSS. The timer
      // is the failsafe for browsers without animation events.
      badge.addEventListener('animationend', (e) => {
        if ((e as AnimationEvent).animationName === 'intro-sheen-once') handOff();
      });
      window.setTimeout(handOff, HANDOFF_AFTER_MS + 900);
      skipBtn?.addEventListener('click', handOff);
    }
  </script>

  <script>
    // Lightweight reveal-on-scroll — staggered per item, honors reduced motion.
    // Content is visible by default (no class-gated hidden state), so this
    // only enhances an already-rendered page.
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!prefersReduced && 'IntersectionObserver' in window) {
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const el = entry.target as HTMLElement;
              const delay = Number(el.dataset.revealDelay ?? 0) * 80;
              el.style.transitionDelay = `${delay}ms`;
              el.classList.add('is-revealed');
              io.unobserve(el);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );
      items.forEach((el) => {
        el.classList.add('reveal-init');
        io.observe(el);
      });
    }
  </script>

  <style is:global>
    #intro-overlay {
      transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .intro-skip {
      color: var(--color-muted);
    }
    .intro-skip:hover,
    .intro-skip:focus-visible {
      color: var(--color-brass-deep);
    }

    /* The badge arrives as one object. Ease-out-expo, no bounce, per
       DESIGN.md's motion rule. */
    @keyframes intro-arrive {
      from { opacity: 0; transform: scale(0.82); }
      to   { opacity: 1; transform: scale(1); }
    }
    /* Pacing lives here — these three are the whole timeline. The handoff
       follows the sheen's animationend, so changing them keeps everything
       in step without touching the script. */
    #intro-overlay {
      --intro-arrive-dur: 1.3s;
      --intro-sheen-delay: 0.6s;
      --intro-sheen-dur: 2.8s;
    }
    #intro-badge {
      animation: intro-arrive var(--intro-arrive-dur) cubic-bezier(0.16, 1, 0.3, 1) both;
      will-change: opacity, transform;
    }

    /* One bronze sheen pass as it lands — the badge's single signature
       move, not a loop. Masked to the badge silhouette so the highlight
       rides the metal instead of sweeping a rectangle: the artwork is a
       transparent PNG and the barbell juts well outside any simple shape. */
    @keyframes intro-sheen-once {
      from { background-position: -120% 0; }
      to   { background-position: 220% 0; }
    }
    .intro-sheen {
      position: relative;
    }
    .intro-sheen::after {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: linear-gradient(
        100deg,
        transparent 42%,
        color-mix(in srgb, var(--color-brass-bright) 42%, transparent) 50%,
        transparent 58%
      );
      background-size: 300% 100%;
      -webkit-mask-image: url("/logo/4everfit-badge-v2.png");
              mask-image: url("/logo/4everfit-badge-v2.png");
      -webkit-mask-size: contain;
              mask-size: contain;
      -webkit-mask-repeat: no-repeat;
              mask-repeat: no-repeat;
      -webkit-mask-position: center;
              mask-position: center;
      animation: intro-sheen-once var(--intro-sheen-dur) ease-in-out var(--intro-sheen-delay) both;
    }
    @media (prefers-reduced-motion: reduce) {
      #intro-badge { animation: none; }
      .intro-sheen::after { animation: none; display: none; }
    }
    #intro-overlay.intro-done {
      opacity: 0;
      pointer-events: none;
    }
    /* Hero badge starts small/invisible and pops in the instant the intro
       hands off — landing bigger than its old resting size so it reads as
       an arrival, not just a fade. No bounce (ease-out-expo only). */
    .hero-badge {
      opacity: 0;
      transform: scale(0.55);
      transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .hero-badge.is-landed {
      opacity: 1;
      transform: scale(1);
    }
    @media (prefers-reduced-motion: reduce) {
      .hero-badge {
        transition: none;
      }
    }

    [data-reveal].reveal-init {
      opacity: 0;
      transform: translateY(18px);
      transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }
    [data-reveal].is-revealed {
      opacity: 1;
      transform: none;
    }

    .store-badge {
      display: inline-flex;
      flex-direction: column;
      justify-content: center;
      gap: 1px;
      padding: 9px 18px;
      border-radius: var(--radius-sm);
      border: 1px solid color-mix(in srgb, var(--color-ink) 30%, transparent);
      color: var(--color-ink);
      line-height: 1.15;
      transition: border-color 0.2s ease-out, background-color 0.2s ease-out;
    }
    .store-badge:hover {
      border-color: var(--color-brass);
      background: var(--color-paper-muted);
    }
    .store-badge-eyebrow {
      font-size: 10px;
      color: var(--color-muted);
    }
    .store-badge-name {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 15px;
    }
  </style>
</Layout>
