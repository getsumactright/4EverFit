---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Field from '../components/Field.astro';
import Tag from '../components/Tag.astro';
import GrayFigure from '../components/GrayFigure.astro';
import Logo from '../components/Logo.astro';
const base = import.meta.env.BASE_URL;

const pillars = [
  {
    index: '01',
    name: 'Nutrition',
    body: 'Macros set to your training load, not a generic calorie target, with a weekly check-in so the plan moves as your life does.',
    items: ['Macro targets', 'Weekly check-ins', 'Eating-out playbook'],
  },
  {
    index: '02',
    name: 'Strength training',
    body: 'Live form coaching on camera and a logged progression, whether you train at home with bands or a full commercial gym.',
    items: ['Live form coaching', 'Logged progression', 'Home or full gym'],
  },
  {
    index: '03',
    name: 'Cardio',
    body: 'A Zone 2 base under everything, interval blocks layered on top, and recovery tracked so hard days stay hard.',
    items: ['Zone 2 base', 'Interval blocks', 'Recovery tracking'],
  },
  {
    index: '04',
    name: 'Supplementation',
    body: 'An audit of the cabinet you already have, an evidence-only stack, and dose timing that actually matches your training.',
    items: ['Cabinet audit', 'Evidence-only stack', 'Dose timing'],
  },
];

const stats = [
  { value: '1:1', unit: '', caption: 'Every session live on camera' },
  { value: '4', unit: '', caption: 'Pillars in every plan we write' },
  { value: '45', unit: 'min', caption: 'Per session, start to cooldown' },
  { value: '0', unit: '', caption: 'Copy-paste programs handed out' },
];

const sessionSteps = [
  { title: 'Warm-up and check-in', body: 'A few minutes on how the week actually went before any weight moves.' },
  { title: 'Coached work, rep by rep', body: 'Your coach watches every set live and corrects form in real time, not after the fact.' },
  { title: 'The week, written down', body: 'Nutrition, cardio and recovery targets for the next seven days, sent to your app before you log off.' },
];

const questions = [
  {
    pillar: 'Nutrition',
    kicker: 'Pillar 01 — Nutrition',
    question: 'How would you describe your eating right now?',
    options: [
      'Dialed in and tracked',
      'Mostly clean, but no real plan',
      "Fine on weekdays, gone by Friday",
      'Honestly, no idea',
    ],
  },
  {
    pillar: 'Strength',
    kicker: 'Pillar 02 — Strength training',
    question: 'Where are you with lifting?',
    options: [
      'Training 3+ days, want progression',
      'On and off for years',
      'Brand new to the barbell',
      'Coming back from an injury',
    ],
  },
  {
    pillar: 'Cardio',
    kicker: 'Pillar 03 — Cardio',
    question: 'How is your conditioning?',
    options: [
      'Running or riding every week',
      "Walks, and that's about it",
      'Winded on the stairs',
      'Competitive — I want more engine',
    ],
  },
  {
    pillar: 'Supplements',
    kicker: 'Pillar 04 — Supplementation',
    question: 'What are you taking today?',
    options: [
      'A full stack — audit it',
      "Protein and that's it",
      'A cabinet full of guesses',
      'Nothing yet',
    ],
  },
];

const credentialsDesktop = ['NSCA-CSCS', 'Precision Nutrition L2', '15 years coaching', '400+ clients'];
const credentialsMobile = ['NSCA-CSCS', 'PN Level 2', '15 years', '400+ clients'];

const results = [
  { before: '4ef-a1', after: '4ef-b1', name: 'Marcus', duration: '16 weeks', stat: '−31 lb · +90 lb squat', statShort: '−31 lb' },
  { before: '4ef-a2', after: '4ef-b2', name: 'Priya', duration: '12 weeks', stat: 'First 5 pull-ups', statShort: 'First 5 pull-ups' },
  { before: '4ef-a3', after: '4ef-b3', name: 'Dev', duration: '20 weeks', stat: 'Back to sprinting', statShort: 'Back to sprinting' },
];

const testimonials = [
  { quote: 'For the first time a coach actually watched me lift instead of just handing me a spreadsheet.', name: 'Marcus T.', role: 'Gym regular' },
  { quote: 'Four pillars sounds simple until you realize most programs only ever give you one.', name: 'Priya N.', role: 'Operations director' },
  { quote: 'Coming back from an injury, the form coaching alone was worth it.', name: 'Dev R.', role: 'Masters sprinter' },
];

const faqItems = [
  {
    q: 'Do I need a gym?',
    a: 'No. Sessions run wherever your camera can see you — a full commercial gym, a home rack, or just floor space, and your plan is written for whatever equipment you actually have.',
  },
  {
    q: 'What does a session actually look like?',
    a: 'A 45-minute video call: a quick check-in on the week, coached work with live form corrections, and the next seven days written to your app before you log off.',
  },
  {
    q: 'Is nutrition a separate service?',
    a: 'No — it is one of the four pillars in every plan, with macro targets and a weekly check-in included from the start, not billed separately.',
  },
  {
    q: 'How often do the four pillars get revisited?',
    a: 'Every week, at minimum. Your coach reads your check-in and adjusts nutrition, training, cardio and supplementation together, not on four different schedules.',
  },
  {
    q: 'What happens after I take the assessment?',
    a: "Your coach reads your four answers and builds your starting plan — you'll get it the moment you open the 4Ever Fit app. No calls, no sales pitch, no card required.",
  },
];
---

<Layout>
  <!-- ═══════════════════════════ INTRO ═══════════════════════════
       Plays once per session before the hero. The badge arrives as one
       object — scale + fade on ease-out-expo, then a single bronze sheen
       pass — and hands off to the hero badge, which is the same asset on
       the same ground, so the arrival reads as one continuous object.

       This replaced badge-intro.mp4 (kept at tag intro-video-v1). That
       clip had the abandoned dark palette baked into its pixels, so it
       could never follow the theme and needed a dark overlay to hide the
       mismatch; it also cost 1.5MB and ran 1.3s of frozen frame. Built
       from CSS on the existing transparent PNG, the intro takes its
       colours from the same tokens as the rest of the page.

       Skippable, reduced-motion safe, and never blocks content — the hero
       is fully in the DOM and readable underneath the whole time. -->
  <div id="intro-overlay" class="fixed inset-0 z-[var(--z-intro)] bg-bg flex items-center justify-center">
    <div id="intro-badge" class="intro-sheen w-[min(62vw,420px)]" aria-hidden="true">
      <img src={`${base}logo/4everfit-badge-v2.png`} alt="" width="1374" height="1145" class="w-full h-auto" />
    </div>
    <button type="button" id="intro-skip" aria-label="Skip intro animation" class="intro-skip absolute bottom-8 right-8 text-[13px] transition-colors">
      Skip intro
    </button>
  </div>

  <!-- ═══════════════════════════ DESKTOP ═══════════════════════════ -->
  <div class="hidden sm:block bg-bg text-cream">
    <!-- 1. Sticky nav -->
    <header class="sticky top-0 z-[var(--z-sticky)] bg-bg/90 backdrop-blur-sm border-b border-[color:var(--color-divider)]">
      <div class="flex items-center gap-8 px-[clamp(24px,5vw,72px)] py-4">
        <Logo href="#top" size="40px" />
        <div class="ml-auto flex items-center gap-8">
          <nav class="hidden min-[900px]:flex items-center gap-8">
            <a href="#pillars" class="text-[14px] text-cream-muted hover:text-cream transition-colors">Pillars</a>
            <a href="#how" class="text-[14px] text-cream-muted hover:text-cream transition-colors">How it works</a>
            <a href="#coach" class="text-[14px] text-cream-muted hover:text-cream transition-colors">Coach</a>
            <a href="#results" class="text-[14px] text-cream-muted hover:text-cream transition-colors">Results</a>
          </nav>
          <button
            type="button"
            data-drawer-trigger
            aria-controls="tablet-drawer"
            aria-expanded="false"
            aria-label="Open menu"
            class="flex min-[900px]:hidden flex-col items-end justify-center gap-[5px] w-11 h-11"
          >
            <span class="block w-6 h-[2px] rounded-full bg-cream" aria-hidden="true"></span>
            <span class="block w-6 h-[2px] rounded-full bg-cream" aria-hidden="true"></span>
            <span class="block w-4 h-[2px] rounded-full bg-brass" aria-hidden="true"></span>
          </button>
          <Button href="#assessment" variant="primary" class="!px-5 !py-2.5 !text-[14px]">
            Take the assessment
          </Button>
        </div>
      </div>
    </header>

    <!-- Tablet-range drawer (640–899px): the full nav in the header above
         only appears at ≥900px, and the dedicated small-breakpoint mobile
         tree below is sm:hidden (≥640px), so this range needs its own nav
         fallback rather than sharing the mobile tree's drawer, whose links
         target #m-* ids that don't exist in this tree's layout. -->
    <div
      id="tablet-drawer"
      data-drawer
      hidden
      role="dialog"
      aria-modal="true"
      aria-label="Menu"
      class="fixed inset-0 z-[var(--z-modal)] min-[900px]:hidden bg-bg-raised text-cream flex flex-col p-5"
    >
      <div class="flex justify-end">
        <button type="button" data-drawer-close class="text-[14px] font-medium py-2">Close</button>
      </div>
      <nav class="mt-8 flex flex-col">
        {['Pillars', 'How it works', 'Coach', 'Results'].map((label) => (
          <a
            data-drawer-link
            href={`#${label === 'How it works' ? 'how' : label.toLowerCase()}`}
            class="border-t border-[color:var(--color-divider)] py-5 text-[28px] font-display font-semibold text-cream"
          >
            {label}
          </a>
        ))}
      </nav>
      <Button href="#assessment" data-drawer-link variant="primary" block class="mt-auto !py-4">
        Take the assessment
      </Button>
    </div>

    <main id="top">
      <!-- 2. Hero -->
      <section class="relative overflow-hidden border-b border-[color:var(--color-divider)]">
        <div class="grid grid-cols-[minmax(0,6fr)_minmax(0,6fr)] max-[980px]:grid-cols-1 items-center">
          <div class="pt-[clamp(56px,8vw,96px)] pb-[clamp(56px,8vw,96px)] px-[clamp(24px,5vw,72px)]" data-reveal>
            <div class="eyebrow text-brass-bright">
              <span class="mark" aria-hidden="true"></span>
              One-on-one video coaching
            </div>
            <h1 class="mt-5 text-[clamp(2.75rem,5vw,4.5rem)] leading-[1.03]">
              Train with a coach on camera.
              <em class="not-italic text-brass-bright">No guesswork.</em>
            </h1>
            <p class="mt-6 text-[18px] leading-[30px] max-w-[46ch] text-cream-muted">
              One-on-one video training built on four pillars — nutrition, strength, cardio and
              supplementation — written into a single plan by one coach, delivered straight to your app.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              <Button href="#assessment" variant="primary" class="!px-7 !py-4 !text-[16px]">Take the 60-second assessment</Button>
              <Button href="#how" variant="secondary" class="!px-7 !py-4 !text-[16px]">See how a session runs</Button>
            </div>
            <div class="mt-7 flex items-center gap-2.5 text-[13px] text-cream-muted">
              <span class="mark" aria-hidden="true"></span>
              4 questions · 60 seconds · no card
            </div>
          </div>
          <div class="relative flex items-center justify-center py-16 px-[clamp(24px,5vw,72px)] max-[980px]:pt-0" data-reveal data-reveal-delay="1">
            <div class="relative w-full max-w-[420px]">
              <GrayFigure
                src={`${base}img/hero-training.jpg`}
                alt="Athlete mid-lift during a coached video training session"
                aspect="3/4"
                rounded
                class="shadow-[var(--shadow-lg)]"
              />
              <div data-hero-badge class="hero-badge badge-sheen absolute -bottom-14 -left-14 w-[220px] h-[220px] rounded-full shadow-[var(--shadow-lg)] max-[1180px]:w-[160px] max-[1180px]:h-[160px] max-[1180px]:-bottom-10 max-[1180px]:-left-10">
                <img src={`${base}logo/4everfit-badge-v2.png`} alt="4Ever Fit Lifestyle badge" class="w-full h-full object-contain rounded-full" width="220" height="220" />
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 3. Stat row -->
      <section class="bg-bg-raised border-b border-[color:var(--color-divider)]">
        <div class="grid grid-cols-4 max-[1040px]:grid-cols-2 px-[clamp(24px,5vw,72px)] py-10 gap-x-8 gap-y-8">
          {stats.map((s) => (
            <div>
              <div class="font-display font-semibold text-[clamp(2rem,3vw,2.75rem)] text-brass-bright">
                {s.value}<span class="text-[0.45em]">{s.unit}</span>
              </div>
              <div class="mt-1 text-[13px] text-cream-muted">{s.caption}</div>
            </div>
          ))}
        </div>
      </section>

      <!-- 4. Four pillars -->
      <section id="pillars" class="py-[clamp(64px,7vw,104px)] px-[clamp(24px,5vw,72px)] border-b border-[color:var(--color-divider)]">
        <div class="mb-12 max-w-[640px]" data-reveal>
          <h2 class="text-[clamp(2rem,3.4vw,3.25rem)] leading-[1.08]">
            Pull one out and the whole thing falls over.
          </h2>
          <p class="mt-4 text-[17px] leading-[28px] text-cream-muted">
            Most programs hand you a lifting split and call it done. Every 4Ever Fit plan is written
            across all four pillars at once, because progress on one without the others is what stalls out.
          </p>
        </div>
        <div class="grid grid-cols-4 max-[1040px]:grid-cols-2 max-[560px]:grid-cols-1 gap-5">
          {pillars.map((p, i) => (
            <div class="bg-bg-raised rounded-[var(--radius-lg)] p-6 border border-[color:var(--color-divider)] transition-transform duration-300 hover:-translate-y-1" data-reveal data-reveal-delay={i % 4}>
              <span class="font-display font-semibold text-[15px] text-brass">{p.index}</span>
              <h3 class="mt-3 text-[21px] font-display font-semibold">{p.name}</h3>
              <p class="mt-3 text-[15px] leading-[24px] text-cream-muted">{p.body}</p>
              <ul class="mt-4 flex flex-wrap gap-1.5 list-none p-0">
                {p.items.map((it) => <Tag>{it}</Tag>)}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- 5. How a session runs -->
      <section id="how" class="bg-bg-raised border-b border-[color:var(--color-divider)]">
        <div class="grid grid-cols-[minmax(0,5fr)_minmax(0,7fr)] max-[900px]:grid-cols-1">
          <GrayFigure
           src={`${base}img/session-coaching.jpg`}
            alt="Coach on a live one-on-one video training session, laptop screen lit warm in a dim room"
            minHeight="460px"
            class="max-[900px]:min-h-[340px]"
          />
          <div class="py-[clamp(48px,6vw,88px)] px-[clamp(24px,5vw,72px)]" data-reveal>
            <h2 class="text-[clamp(2rem,3.4vw,3.25rem)] leading-[1.08]">45 minutes. Camera on. Nothing to figure out.</h2>
            <div class="mt-8">
              {sessionSteps.map((step, i) => (
                <div class:list={['grid grid-cols-[56px_1fr] gap-4 py-5', i > 0 && 'border-t border-[color:var(--color-divider)]']}>
                  <div class="font-display font-semibold text-[22px] text-brass [font-feature-settings:'tnum'_1]">
                    {String(i + 1).padStart(2, '0')}
                  </div>
                  <div>
                    <h4 class="text-[18px] font-display font-semibold">{step.title}</h4>
                    <p class="mt-2 text-[15px] leading-[26px] text-cream-muted">{step.body}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- 6. Assessment — the conversion point -->
      <section id="assessment" class="py-[clamp(64px,7vw,104px)] px-[clamp(24px,5vw,72px)] border-b border-[color:var(--color-divider)]">
        <div class="grid grid-cols-[minmax(0,4fr)_minmax(0,7fr)] max-[900px]:grid-cols-1 gap-[clamp(32px,5vw,80px)] items-start">
          <div data-reveal>
            <div class="eyebrow text-brass-bright">
              <span class="mark" aria-hidden="true"></span>
              The 4-pillar assessment
            </div>
            <h2 class="mt-4 text-[clamp(2rem,3.4vw,3.25rem)] leading-[1.08]">Four questions. One per pillar.</h2>
            <p class="mt-4 text-[17px] leading-[28px] max-w-[42ch] text-cream-muted">
              Sixty seconds, no card, no calls you didn't ask for. Finish it and your starting plan is
              waiting for you in the 4Ever Fit app.
            </p>
          </div>

          <div data-assessment="desktop" class="on-paper bg-paper text-ink rounded-[var(--radius-lg)] shadow-[var(--shadow-lg)] overflow-hidden">
            <div class="sr-only" aria-live="polite" data-role="live-region"></div>
            <!-- progress header -->
            <div class="grid grid-cols-4 border-b border-[color:var(--color-divider-onlight)]">
              {questions.map((q, i) => (
                <div
                  data-progress-item={i}
                  data-done="false"
                  class:list={['p-4', i > 0 && 'border-l border-[color:var(--color-divider-onlight)]']}
                >
                  <span class="mark-hollow" aria-hidden="true" data-progress-marker></span>
                  <div class="mt-2 text-[11px] uppercase tracking-[0.06em] text-[color:var(--color-muted)]">{q.pillar}</div>
                </div>
              ))}
            </div>

            <div class="p-8">
              {questions.map((q, i) => (
                <fieldset data-step-panel={i} class="border-0 p-0 m-0" aria-labelledby={`d-q${i}-heading`}>
                  <legend class="sr-only">{q.kicker}</legend>
                  <div class="text-[12px] tracking-[0.08em] uppercase text-[color:var(--color-brass-deep)]">{q.kicker}</div>
                  <h3 id={`d-q${i}-heading`} class="mt-2 text-[clamp(1.4rem,2vw,1.9rem)] leading-[1.15] font-display font-semibold">{q.question}</h3>
                  <div class="mt-5">
                    {q.options.map((opt) => (
                      <label class="flex items-center gap-4 px-3 py-4 rounded-[var(--radius-sm)] cursor-pointer hover:bg-[color:var(--color-paper-muted)] transition-colors">
                        <input type="radio" name={`d-q${i}`} data-step={i} value={opt} class="sr-only" />
                        <span class="mark-hollow" aria-hidden="true"></span>
                        <span class="text-[16px]">{opt}</span>
                      </label>
                    ))}
                  </div>
                </fieldset>
              ))}

              <form data-step-panel="capture" hidden>
                <div class="text-[12px] tracking-[0.08em] uppercase text-[color:var(--color-brass-deep)]">Last step</div>
                <h3 class="mt-2 text-[clamp(1.4rem,2vw,1.9rem)] leading-[1.15] font-display font-semibold">Where should we send the plan?</h3>
                <p class="mt-3 text-[15px] leading-[24px] max-w-[46ch] text-[color:var(--color-muted)]">
                  One email, and your plan is waiting in the app the moment you log in.
                </p>
                <div class="mt-5 max-w-[460px] space-y-4">
                  <Field label="First name" name="d-name" placeholder="Jordan" />
                  <Field label="Email" name="d-email" type="email" placeholder="you@work.com" required />
                </div>
                <p data-role="error" class="mt-3 text-[13px] text-[color:var(--color-brass-deep)]" role="alert" tabindex="-1" hidden></p>
                <div class="mt-6 flex items-center gap-3">
                  <Button type="submit" data-action="submit" variant="primary" class="!px-7 !py-3.5">Send my plan</Button>
                  <Button type="button" data-action="back" variant="secondary" class="!px-7 !py-3.5">Back</Button>
                </div>
              </form>

              <div data-step-panel="submitted" hidden>
                <span class="mark" aria-hidden="true"></span>
                <h3 data-role="thanks-title" class="mt-3 text-[clamp(1.4rem,2vw,1.9rem)] leading-[1.15] font-display font-semibold">Your assessment is in.</h3>
                <p class="mt-3 text-[15px] leading-[24px] max-w-[46ch] text-[color:var(--color-muted)]">
                  Your coach is building your plan now. Get the 4Ever Fit app to log in and see it — that's
                  where every session, check-in and message with your coach lives from here on.
                </p>
                <div class="mt-5 flex flex-wrap gap-3">
                  <a href="#" class="store-badge" aria-label="Download on the App Store">
                    <span class="store-badge-eyebrow">Download on the</span>
                    <span class="store-badge-name">App Store</span>
                  </a>
                  <a href="#" class="store-badge" aria-label="Get it on Google Play">
                    <span class="store-badge-eyebrow">Get it on</span>
                    <span class="store-badge-name">Google Play</span>
                  </a>
                </div>
                <Button type="button" data-action="start-over" variant="secondary" class="mt-5 !px-5 !py-2.5 !text-[13px]">Start over</Button>
              </div>
            </div>

            <div class="flex items-center justify-between px-8 pb-6" data-role="footer-row">
              <Button type="button" data-action="back" variant="secondary" class="!px-5 !py-2.5 !text-[13px]">Back</Button>
              <span data-role="progress-label" class="text-[13px] text-[color:var(--color-muted)]"></span>
            </div>
          </div>
        </div>
      </section>

      <!-- 7. Coach -->
      <section id="coach" class="border-b border-[color:var(--color-divider)]">
        <div class="grid grid-cols-[minmax(0,5fr)_minmax(0,7fr)] max-[900px]:grid-cols-1">
          <GrayFigure
            src={`${base}img/coach-portrait.jpg`}
            alt="Portrait of the coach in a dim private training studio"
            minHeight="520px"
          />
          <div class="py-[clamp(48px,6vw,88px)] px-[clamp(24px,5vw,72px)]" data-reveal>
            <h2 class="text-[clamp(2rem,3.4vw,3.25rem)] leading-[1.08]">One coach. Your whole file.</h2>
            <p class="mt-5 text-[17px] leading-[28px] max-w-[52ch] text-cream-muted">
              Every plan — nutrition, strength, cardio and supplementation — is written and read by the
              same person, so nothing falls between four different apps.
            </p>
            <p class="mt-4 text-[17px] leading-[28px] max-w-[52ch] text-cream-muted">
              Fifteen years coaching on camera, credentialed across strength and nutrition, and every
              session logged into one file your coach actually reads before writing your week.
            </p>
            <div class="mt-8 flex flex-wrap gap-2.5 max-w-[440px]">
              {credentialsDesktop.map((c) => (
                <span class="text-[13px] font-medium px-3.5 py-2 rounded-full bg-bg-raised border border-[color:var(--color-divider)]">{c}</span>
              ))}
            </div>
            <p class="mt-4 text-[12px] text-[color:var(--color-cream-muted)]">Placeholder credentials — confirm with client before launch.</p>
          </div>
        </div>
      </section>

      <!-- 8. Results gallery -->
      <section id="results" class="py-[clamp(64px,7vw,104px)] px-[clamp(24px,5vw,72px)] border-b border-[color:var(--color-divider)]">
        <h2 class="text-[clamp(2rem,3.4vw,3.25rem)] leading-[1.08] max-w-[20ch]" data-reveal>Twelve weeks of doing the boring things.</h2>
        <div class="mt-10 grid grid-cols-3 max-[900px]:grid-cols-1 gap-6">
          {results.map((r, i) => (
            <div class="on-paper bg-paper rounded-[var(--radius-lg)] overflow-hidden shadow-[var(--shadow-md)]" data-reveal data-reveal-delay={i}>
              <div class="grid grid-cols-2 gap-[2px] bg-[color:var(--color-divider-onlight)]">
                <GrayFigure src={`https://picsum.photos/seed/${r.before}/600/800`} alt={`${r.name} before, at the start of the program`} aspect="3/4" />
