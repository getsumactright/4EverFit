---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---
<span class:list={['tag-outline inline-flex items-center text-[12px] font-medium px-3 py-1.5 rounded-full border border-[color:var(--color-brass)] text-[color:var(--color-brass-deep)] bg-[color:var(--color-paper-muted)]', className]}>
  <slot />
</span>
