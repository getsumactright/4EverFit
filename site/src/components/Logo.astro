---
// Logo — the client's actual mark: a cast bronze/gunmetal badge
// (branding/final/4everfit-badge-logo-final.png). Used as a small icon
// next to a type-set wordmark at nav/footer sizes (the badge's internal
// text is illegible below ~40px), and full-size, with the one-time sheen
// sweep, in the hero.
interface Props {
  size?: string; // badge diameter, e.g. "36px"
  href?: string;
  class?: string;
  showTag?: boolean;
  wordmarkSize?: string;
}
const {
  size = '36px',
  href = '#top',
  class: className = '',
  showTag = true,
  wordmarkSize,
} = Astro.props;
const resolvedWordmark = wordmarkSize ?? `calc(${size} * 0.5)`;
---
<a href={href} class:list={['logo-lockup inline-flex items-center gap-2.5', className]}>
  <img
    src="/logo/4everfit-badge-v2.png"
    alt=""
    aria-hidden="true"
    class="logo-badge"
    style={`width:${size};height:${size}`}
    width="140"
    height="140"
  />
  <span class="logo-word-stack">
    <span class="logo-word" style={`font-size:${resolvedWordmark}`}>4Ever Fit</span>
    {showTag && <span class="logo-tag">Lifestyle</span>}
  </span>
  <span class="sr-only">4Ever Fit Lifestyle — home</span>
</a>

<style>
  .logo-lockup {
    text-decoration: none;
  }
  .logo-badge {
    display: block;
    object-fit: contain;
    flex: none;
  }
  .logo-word-stack {
    display: flex;
    flex-direction: column;
    line-height: 1;
    gap: 3px;
  }
  .logo-word {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-cream);
    white-space: nowrap;
  }
  .logo-tag {
    font-family: var(--font-body);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-brass-bright);
    white-space: nowrap;
  }
  /* On paper (light) sections the lockup needs dark ink instead of cream —
     opt in with .on-paper where the logo sits on --color-paper. */
  :global(.on-paper) .logo-word { color: var(--color-ink); }
  :global(.on-paper) .logo-tag { color: var(--color-brass-deep); }
</style>
